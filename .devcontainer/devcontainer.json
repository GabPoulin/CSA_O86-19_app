{
  "name": "Datum (Python 3.14)",
  // Python 3.14 : même version que l'application en ligne (Streamlit Cloud)
  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Accueil.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  // Installe l'application et les outils de développement (pytest)
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && echo '✅ Dépendances installées'",
  // CORS et XSRF désactivés : nécessaire pour l'aperçu de l'app dans GitHub Codespaces
  // (configuration du gabarit officiel de Streamlit). Environnement de développement seulement.
  "postAttachCommand": {
    "server": "streamlit run Accueil.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
